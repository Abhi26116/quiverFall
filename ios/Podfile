# Uncomment this line to define a global platform for your project
platform :ios, '13.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Quiverfall / Phase 0 — iOS 13.0 floor, per docs/12-architecture.md.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'

      %w[LIBRARY_SEARCH_PATHS OTHER_LDFLAGS].each do |key|
        value = config.build_settings[key]
        next if value.nil?

        config.build_settings[key] =
          if value.is_a?(Array)
            value.map { |v| v.gsub('DT_TOOLCHAIN_DIR', 'TOOLCHAIN_DIR') }
          else
            value.gsub('DT_TOOLCHAIN_DIR', 'TOOLCHAIN_DIR')
          end
      end
    end
  end

  # CocoaPods 1.12.x emits DT_TOOLCHAIN_DIR, which Xcode 15 rejects with
  # "DT_TOOLCHAIN_DIR cannot be used to evaluate LIBRARY_SEARCH_PATHS".
  #
  # Rewriting build_settings above only fixes the aggregate Pods-Runner config;
  # per-pod xcconfigs are written straight to disk from each podspec, so they
  # have to be patched as files after generation.
  #
  # The upstream fix is CocoaPods >= 1.13, but that is a global change on this
  # machine and would affect arrows-game and screw_jam_universe. Delete this
  # block once CocoaPods is upgraded. See docs/decisions/0001-toolchain.md.
  Dir.glob(File.join(installer.sandbox.root, 'Target Support Files', '**', '*.xcconfig')).each do |path|
    contents = File.read(path)
    next unless contents.include?('DT_TOOLCHAIN_DIR')

    File.write(path, contents.gsub('DT_TOOLCHAIN_DIR', 'TOOLCHAIN_DIR'))
  end
end
